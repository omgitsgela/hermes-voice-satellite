[Unit]
Description=Hermes Voice Bridge - Wyoming satellite voice frontend
After=network-online.target hermes-gateway.service
Wants=network-online.target
# The bridge dials the satellite on tcp/10700 and the Hermes API server on loopback 8642.
# Deliberately no Requires=hermes-gateway: it retries by itself, so a gateway restart or an
# update should not cascade into taking the bridge down with it.

[Service]
Type=simple
WorkingDirectory=/home/angela/hermes-voice-bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/angela/hermes-voice-bridge/.venv/bin/python -m bridge.loop
Restart=always
# A satellite that is switched off cannot be dialled, and every attempt costs about 1.3s of CPU
# reloading the whisper and Piper models before it fails. At 5s that was ~25% of a core for hours
# (3,210 restarts observed on 2026-09-24). 60s still recovers on its own, twelve times less often.
# The hourly in-process reconnect covers transient blips, so this path is only for real death.
RestartSec=60
# A turn can legitimately take a while (tool calls, a long spoken answer). Give it room to finish
# rather than SIGKILLing mid-playback.
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
