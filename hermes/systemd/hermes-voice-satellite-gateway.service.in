[Unit]
Description=Hermes Voice Satellite - Satellite Gateway
After=network-online.target hermes-gateway.service
Wants=network-online.target
# The Gateway dials the satellite on its configured port and the Hermes API server on loopback.
# Deliberately no Requires=hermes-gateway: it retries by itself, so a gateway restart or an
# update should not cascade into taking the Gateway down with it.

[Service]
Type=simple
# __BASE__ is the repository checkout the gateway runs from (substituted by install-gateway.sh;
# the committed hermes-voice-satellite-gateway.service is the same unit pinned to %h/hermes-voice-satellite for
# the documented clone location).
WorkingDirectory=__BASE__
# The host side's one configuration file (satellite-gateway.env at the project root, git-ignored; see
# satellite-gateway.env.example). A missing file is not fatal: every value then falls back to its default
# in gateway/config.py, and an unconfigured Gateway dials loopback and says so. systemd
# EnvironmentFile values override manager/Environment= values; for a service override,
# use a later EnvironmentFile in a drop-in. Direct Python runs prefer their environment.
EnvironmentFile=-__BASE__/satellite-gateway.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__BASE__/.venv/bin/python -m satellite_gateway.loop
Restart=always
# A satellite that is switched off cannot be dialled, and every attempt costs about 1.3s of CPU
# reloading the whisper and Piper models before it fails. At 5s that was ~25% of a core for hours
# (3,210 restarts observed on 2026-09-24). 60s still recovers on its own, twelve times less often.
# The hourly in-process reconnect covers transient blips, so this path is only for real death.
RestartSec=60
# A turn can legitimately take a while (tool calls, a long spoken answer). Give it room to finish
# rather than SIGKILLing mid-playback.
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
