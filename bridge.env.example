# bridge.env.example
#
# Copy to bridge.env (at the project root, next to bridge/) and fill in the values for THIS
# installation. bridge.env is git-ignored: it is the one place the host side's real values live,
# read by bridge/config.py (environment first, then this file, then the default in the code).
#
# The host's systemd unit also points at this same file (EnvironmentFile=), so a value set here is
# visible to both the running service and a script run by hand from the same shell. Direct Python
# runs prefer their process environment, including explicitly empty values. systemd loads this
# file over manager/Environment= values; use a later EnvironmentFile drop-in for service overrides.
# Syntax follows systemd EnvironmentFile: no variable expansion or inline comments; single and
# double quotes, backslash escapes and line continuations are supported. Restart to reread changes.
#
# Only the values you actually want to override need to appear here; everything else falls back to
# the default written in bridge/config.py.

# --- the satellite: where the bridge dials ------------------------------------
# REQUIRED on any deployment: the default is loopback on purpose, so an unconfigured clone fails
# visibly and locally instead of hunting a foreign address.
VOICE_SATELLITE_HOST=CHANGE-ME
VOICE_SATELLITE_PORT=10700

# --- the gateway and the voice session ----------------------------------------
# VOICE_GATEWAY_URL=http://127.0.0.1:8642
# VOICE_ROUTE_ALIAS=voice-fast
# Stable session id: carry the device's name so the assistant has continuity across restarts.
# VOICE_SESSION_ID=voice-satellite

# --- the spoken voice ----------------------------------------------------------
# The Piper voice the bridge speaks with, and its settings. Catalog voices: download with
# .venv/bin/python -m piper.download_voices --download-dir voices <name>. Curated external
# voices like clean100: .venv/bin/python scripts/fetch-voice.py clean100 --download-dir voices
# The full procedure, speaker selection, and licence notes: docs/switching-voices.md
# VOICE_PIPER_VOICE=en_US-hfc_male-medium
# Multi-speaker voices: a speaker name from the voice's own map (list them with
# scripts/list-piper-speakers.py). Ignored by single-speaker voices; empty = the voice's default.
# For clean100 the map's name "78" is its numeric speaker 36.
# VOICE_PIPER_SPEAKER=
# Speaking rate: < 1 faster, > 1 slower; empty = the voice's own default.
# VOICE_PIPER_LENGTH_SCALE=

# --- the registry listener (issue #61) ----------------------------------------
# Off by default. Only these when the device dials the bridge:
# VOICE_REGISTRY_ENABLED=1
# VOICE_REGISTRY_HOST=127.0.0.1
# VOICE_REGISTRY_PORT=10701
# VOICE_REGISTRY_DUPLICATE_POLICY=replace
# VOICE_REGISTRY_WAIT_RETRY_SECONDS=30
# VOICE_REGISTRY_LEASE_WAIT_SECONDS=30
# Rollback only: allow the bridge to dial the device directly as well.
# VOICE_DIRECT_DIAL_FALLBACK=0

# --- fleet wake arbitration (issues #111/#32) -----------------------------------
# When several armed devices hear ONE utterance, the device that heard it best gets
# the turn (measured level first, wake score as tiebreaker, arrival last). The claim
# window is how long the bridge waits for the other devices' detections before
# deciding. 0 = first arrival wins outright (the default, and the safe shape while
# any device runs firmware that reports no level). ~500 suits a fleet where every
# device reports wake levels; bigger windows add latency to every turn.
# VOICE_WAKE_CLAIM_WINDOW_MS=0

# --- announcements -------------------------------------------------------------
# The default preserves a trusted-LAN deployment. On a public host, bind to loopback
# or a private trusted interface; do not expose this endpoint without a transport plan.
# VOICE_ANNOUNCE_HOST=127.0.0.1
# VOICE_ANNOUNCE_PORT=8765
# Bearer token for the announcement endpoint. If this is commented out, the token is read from
# state/announce-token.txt instead.
# VOICE_ANNOUNCE_TOKEN=

# --- satellite enrolment --------------------------------------------------------
# The five-word token a new satellite is set up with. If this is commented out, the token is
# read from state/enroll-token.txt instead (generated once by install-gateway.sh and printed
# there, or lazily by the bridge on first start). Never logged, never transmitted.
# VOICE_ENROLL_TOKEN=
