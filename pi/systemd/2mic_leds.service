# /etc/systemd/system/2mic_leds.service
[Unit]
Description=2Mic LEDs

[Service]
Type=simple
EnvironmentFile=/etc/voice-satellite/satellite.env
# systemd does not expand environment variables in WorkingDirectory= (only specifiers like %h and
# literal paths), so the working directory is set with a cd inside ExecStart instead. The paths and
# the event port come from satellite.env, not from here.
ExecStart=/bin/sh -c 'cd "$VS_BASE/examples" && exec "$VS_BASE/examples/.venv/bin/python3" 2mic_service.py --uri "tcp://127.0.0.1:${VS_EVENT_PORT}"'
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
