# The device side of the inverted shape: the satellite dials the bridge.
#
# This is a template. Substitute before installing on a device (scripts/deploy-to-card.sh does this when
# it writes a card, and the same substitutions apply to a live device):
#
#   __ENV_FILE__  the device's bootstrap file, e.g. /home/<user>/bridge-link.env
#   __PYTHON__    an interpreter that can import `wyoming` (on a Pi built with pi/script, that is the
#                 satellite's own virtualenv, NOT the system python3)
#   __RUNNER__    the installed path of pi/outbound_satellite.py
#
# Install by writing it to /etc/systemd/system/outbound-satellite.service and enabling it, which creates
# the multi-user.target.wants symlink. Nothing else has to reach the device: the link is outbound, so a
# device on any network that can reach the bridge gets its voice link without a port forward anywhere.
#
# It prefers the satellite service without requiring it. The unit is ordered After= the satellite so the
# relay usually finds its peer already listening, but it deliberately does not Require= it, because
# _serve_local() retries until the satellite appears: this service and the satellite start together on a
# boot and the satellite is the slower of the two. A hard dependency would turn that ordinary race into a
# failed unit.
#
# The two do share the audio device, by design: the relay hands the bridge's events to the satellite
# service, which is what does the listening and the speaking. The dial-in path on that service keeps
# working alongside this link while the bridge supports both shapes, so nothing is lost during cutover.

[Unit]
Description=Outbound link from this satellite to the Hermes voice bridge
After=network-online.target wyoming-satellite.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
ExecStart=__PYTHON__ __RUNNER__
# The link reconnects by itself, with capped jitter and a backoff that only resets after the connection
# has been healthy for a while, so this outer restart covers real death only.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
