# /etc/voice-satellite/satellite.env
#
# The device's one configuration file. Every satellite unit under pi/systemd/ reads it with
# EnvironmentFile= and references these variables in ExecStart, so the install location, the
# device's name and the sounds it plays live HERE, in one place, instead of being rewritten in
# four unit files.
#
# This committed copy is a TEMPLATE. Install it to /etc/voice-satellite/satellite.env on the
# device and fill in the <...> values for that device. That file is the one place the device's
# real values live; the units only ever reference the variables. A different layout or a different
# user is a different value here, not an edit to any unit.
#
# How to move an existing installation: change VS_BASE, then daemon-reload and restart the
# services. Nothing else has to change.

# Where the satellite software is installed on this device.
VS_BASE=/home/<satellite-user>/wyoming-satellite

# Where the wake word engine is installed (separate from the satellite).
VS_OPENWAKEWORD=/home/<satellite-user>/wyoming-openwakeword

# The device's identity as the bridge and the house will know it. Keep it stable: the registry
# remembers devices by this id, and the bridge's session continuity keys off it.
VS_DEVICE_NAME=<device-name>

# Where the device's sound files live (awake.wav, done.wav, power-on.wav, ...).
VS_SOUNDS=/home/<satellite-user>/sounds

# Where the custom wake word models live, named by filename stem.
VS_WAKE_MODELS=/home/<satellite-user>/wake-models

# The wake word this device listens for. The satellite and the wake shim must name the same word
# (scripts/test_pi_units_consistent.py checks the units agree), and the model file with this stem
# must exist in VS_WAKE_MODELS.
VS_WAKE_WORD=<wake-word>

# Wake word threshold. 0.35 (openWakeWord's default is 0.5) was applied on 2026-09-22 because the
# word was hard to trigger at the default; measure before changing it.
VS_WAKE_THRESHOLD=0.35

# LED strip global brightness, 1-31 (the APA102 driver's range; the service refuses anything else).
# Written by the configuration plane when the operator changes led_brightness.
VS_LED_BRIGHTNESS=31

# How long the microphone stays muted after the awake tone, in addition to the tone's own duration
# (see issue #47 for why this exists).
VS_MIC_MUTE_AFTER_AWAKE=0.4

# The satellite's own event listener and the relay it serves. Loopback only.
VS_EVENT_PORT=10500
VS_SATELLITE_PORT=10700
