# /etc/systemd/system/wyoming-satellite.service
[Unit]
# Retry calmly and without a rate limit. A cold boot can lose the wake-word race more than
# once, and the previous policy (RestartSec=1 plus a limit of 5 starts in 10s) left the
# unit abandoned and dead until a power cycle. Unbounded is safe now that the power-on
# tone is gated to once per boot, so a retry loop is silent.
StartLimitIntervalSec=0
Description=Wyoming Satellite
Wants=network-online.target
After=network-online.target
Requires=wyoming-openwakeword.service
After=wyoming-openwakeword.service
Requires=2mic_leds.service
After=2mic_leds.service


[Service]
Type=simple
EnvironmentFile=/etc/voice-satellite/satellite.env
# Every path and identity in this unit comes from satellite.env, the device's one
# configuration file (template in the repository at pi/systemd/satellite.env). systemd does not
# expand environment variables in WorkingDirectory= (only specifiers like %h and literal paths),
# so the working directory is set with a cd inside ExecStart; the rest is ordinary ${} expansion.
# The power-on tone plays once per boot, gated by /run, not once per restart (a crash loop
# would otherwise become an alarm loop). The tone lives in satellite.env.
ExecStartPre=-/bin/sh -c 'test -e /run/wyoming-power-on-said || { touch /run/wyoming-power-on-said; exec /usr/bin/aplay -D plughw:CARD=seeed2micvoicec,DEV=0 ${VS_SOUNDS}/power-on.wav; }'
# led_cmd.py is a safety net, not the main path. The bridge publishes led-busy and led-idle
# itself, because a hook here cannot tell the bridge's "One moment." filler from the real
# answer (both arrive as AudioStart), which ended the pulse a second after it started. This
# hook still ends the pulse after any playback completes, covering error paths and
# announcements. Loopback only, so nothing new is exposed to the LAN.
ExecStart=/bin/sh -c 'cd "$VS_BASE" && exec "$VS_BASE/script/run" --name "$VS_DEVICE_NAME" --uri "tcp://0.0.0.0:${VS_SATELLITE_PORT}" \
    --mic-command "arecord -D plughw:CARD=seeed2micvoicec,DEV=0 -r 16000 -c 1 -f S16_LE -t raw" \
    --snd-command "aplay -D plughw:CARD=seeed2micvoicec,DEV=0 -r 22050 -c 1 -f S16_LE -t raw" \
    --wake-uri "tcp://127.0.0.1:10400" \
    --wake-word-name "$VS_WAKE_WORD" \
    --event-uri "tcp://127.0.0.1:${VS_EVENT_PORT}" \
    --awake-wav "$VS_SOUNDS/awake.wav" \
    --done-wav "$VS_SOUNDS/done.wav" \
    --mic-seconds-to-mute-after-awake-wav "$VS_MIC_MUTE_AFTER_AWAKE" \
    --tts-played-command "/usr/bin/python3 ${VS_BASE}/examples/led_cmd.py idle"'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target

# /etc/systemd/system/wyoming-satellite.service.d/10-requires-shim.conf
[Unit]
# The wake shim now sits between this satellite and the wake service, so it has to be listening first,
# and restarting it has to bounce the satellite: a satellite does not re-dial a wake service that
# disappears underneath it.
#
# Consequence, same trap as the LED service: stopping or restarting wake-shim.service also stops or
# restarts wyoming-satellite.service. After any shim restart, check
# `systemctl is-active wyoming-satellite` and start it if needed.
Requires=wake-shim.service
After=wake-shim.service
