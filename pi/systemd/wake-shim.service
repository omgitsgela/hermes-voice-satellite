# /etc/systemd/system/wake-shim.service
[Unit]
Description=Wake word shim (on-demand microphone release for follow-up mode)
Wants=network-online.target
After=network-online.target
# The shim proxies the wake service, so that service should be up first. It is not Requires= on
# wyoming-openwakeword because the shim retries its upstream connection on its own, and a wake
# service restart must not take the microphone path down with it.
After=wyoming-openwakeword.service
Wants=wyoming-openwakeword.service

[Service]
Type=simple
EnvironmentFile=/etc/voice-satellite/satellite.env
# The satellite's virtualenv: this speaks the wyoming protocol and needs that package. The cd
# inside ExecStart is how the working directory is set, because systemd will not expand variables
# in WorkingDirectory=.
#
# --wake-name names the wake word in the synthetic Detection the shim injects. It is only ever
# logged (the satellite treats any Detection as a wake), but leaving it at the shim's default made
# the Gateway log a wake word this device no longer uses after an injected wake, sending a future
# diagnosis after the wrong thing. It must match the satellite's own --wake-word-name, and
# scripts/test_pi_units_consistent.py fails if the two disagree.
ExecStart=/bin/sh -c 'cd "$VS_BASE/examples" && exec "$VS_BASE/.venv/bin/python3" "$VS_BASE/examples/wake_shim.py" --wake-name "$VS_WAKE_WORD"'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
